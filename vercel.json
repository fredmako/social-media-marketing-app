{
  "nodeVersion": "22.x",
  "installCommand": "cd client && npm install",
  "buildCommand": "cd client && VITE_BACKEND_URL=https://api.social-mcp.me npm run build",
  "outputDirectory": "client/dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
