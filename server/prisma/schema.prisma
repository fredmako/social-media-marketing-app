datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id         String     @id @default(uuid())
  name       String
  brandVoice String?
  logoUrl    String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  users      User[]
  products   Product[]
  campaigns  Campaign[]
  leads      Lead[]
  templates  WhatsAppTemplate[]
  engagements WhatsAppEngagement[]
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  name     String
  role     String // ADMIN, EDITOR
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Product {
  id             String        @id @default(uuid())
  name           String
  description    String
  targetAudience String
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adCreatives    AdCreative[]
}

model Campaign {
  id       String   @id @default(uuid())
  name     String
  status   String   // DRAFT, ACTIVE, COMPLETED
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  posts    Post[]
}

model AdCreative {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  headline  String
  bodyText  String
  hashtags  String   // comma separated
  imageUrl  String?
  videoUrl  String?
  posts     Post[]
}

model Post {
  id             String              @id @default(uuid())
  campaignId     String
  campaign       Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  adCreativeId   String
  adCreative     AdCreative          @relation(fields: [adCreativeId], references: [id], onDelete: Cascade)
  platform       String              // x, linkedin, facebook, discord, whatsapp, tiktok
  status         String              // SCHEDULED, PUBLISHED, FAILED
  scheduledTime  DateTime
  publishedTime  DateTime?
  platformPostId String?
  errorMessage   String?
  analytics      AnalyticsSnapshot[]
}

model AnalyticsSnapshot {
  id         String   @id @default(uuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  views      Int
  likes      Int
  shares     Int
  recordedAt DateTime @default(now())
}

model BusinessProfile {
  id         String   @id @default(uuid())
  tenantId   String
  productName String
  description String
  targetAudience String
  brandVoice String?
  offerType  String?
  primaryPain String?
  primaryGain String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Lead {
  id               String    @id @default(uuid())
  tenantId         String
  name             String?
  email            String?
  phone            String?
  source           String?
  score            Int       @default(0)
  status           String    @default("new")
  notes            String?
  consentWhatsapp  Boolean   @default(false)
  optOutAt         DateTime?
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  utmContent       String?
  utmTerm          String?
  createdAt        DateTime  @default(now())
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  engagements      WhatsAppEngagement[]
}

model WhatsAppTemplate {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  body        String
  variables   String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  engagements WhatsAppEngagement[]
}

model WhatsAppEngagement {
  id                String   @id @default(uuid())
  tenantId          String
  leadId            String
  templateId        String?
  type              String
  direction         String?
  status            String   @default("queued")
  toPhone           String
  fromPhone         String?
  messageSid        String?
  errorMessage      String?
  contentPreview    String?
  sentAt            DateTime?
  readAt            DateTime?
  repliedAt         DateTime?
  createdAt         DateTime @default(now())
}
